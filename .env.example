# LLM provider: DashScope / Qwen OpenAI-compatible API
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Public URL shown in generated artifact links.
# Local demo: http://localhost:8000
# Mac LAN demo: http://<your-mac-ip>:8000
# Cloud/production: https://your-domain.example
BASE_PUBLIC_URL=http://localhost:8000

# Optional DingTalk robot webhook adapter.
# Use this for outbound Markdown messages to a DingTalk group robot.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Optional Feishu webhook adapter.
# Feishu is not the main demo channel, but this keeps the channel shape ready.
FEISHU_WEBHOOK=

# Optional OpenClaw Gateway adapter.
# Keep USE_EXTERNAL_OPENCLAW=false for tomorrow's stable local fallback demo.
# Set true only after OpenClaw channel/tools are verified.
USE_EXTERNAL_OPENCLAW=false
OPENCLAW_ENDPOINT=
OPENCLAW_TOKEN=

# Runtime artifact output directory.
ARTIFACT_DIR=generated-artifacts
